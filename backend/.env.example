SECRET_KEY=change-me
DEBUG=True
DB_NAME=lexcore_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID (Web)
GOOGLE_OAUTH_CLIENT_ID=

# Frontend origin used in password-reset email links
FRONTEND_URL=http://localhost:5173

# Gmail SMTP (use a Google App Password, not your normal password)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-gmail@gmail.com
EMAIL_HOST_PASSWORD=xxxx xxxx xxxx xxxx
# Must be the same mailbox as EMAIL_HOST_USER for Gmail SMTP
DEFAULT_FROM_EMAIL=your-gmail@gmail.com
EMAIL_FROM_NAME=LexCore Chambers
EMAIL_REPLY_TO=your-gmail@gmail.com
